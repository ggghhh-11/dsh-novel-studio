{
  "name": "dsh-novel-studio",
  "version": "0.3.1",
  "type": "module",
  "description": "小说创作工作台：意图触发、创作模板、大纲/章纲/正文流水线、多子智能体评审、AI 味扫描与可视化故事图谱。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "writing",
    "story",
    "chinese-webnovel"
  ],
  "author": "ggghhh-11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggghhh-11/dsh-novel-studio.git"
  },
  "homepage": "https://github.com/ggghhh-11/dsh-novel-studio#readme",
  "bugs": {
    "url": "https://github.com/ggghhh-11/dsh-novel-studio/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
